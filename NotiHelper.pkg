&EN
#{"NotiHelper"},(0xA0000D15),1,1,4

; S60 3.1 (E51) and S60 3.2. Without a platform dependency the installer
; cannot match the package to the phone and warns that it is incompatible.
[0x102032BE],0,0,0,{"S60ProductID"}
[0x102752AE],0,0,0,{"S60ProductID"}

%{"Resymbian"}
:"Resymbian"

; The agent shows a note and writes an Inbox entry. Open4All is not required
; by either API, but is normally already active for the TLS-patched JARs.
"NotiHelper.exe"-"!:\sys\bin\NotiHelper.exe"
"NotiHelper.rsc"-"!:\resource\apps\NotiHelper.rsc"
"NotiHelper_reg.rsc"-"!:\private\10003a3f\import\apps\NotiHelper_reg.rsc"
