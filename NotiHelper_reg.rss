// Application-menu registration for the S60 GUI app. Without this resource
// S60 installs the binary but never shows an icon, so there is no way to start
// the loopback listener. The AppUi hides itself but keeps its window group,
// which is what draws the running spinner in the application/task view.

#include <appinfo.rh>

UID2 KUidAppRegistrationResourceFile
UID3 0xA0000D15

RESOURCE APP_REGISTRATION_INFO
    {
    app_file = "NotiHelper";
    localisable_resource_file = "\\resource\\apps\\NotiHelper";
    }
