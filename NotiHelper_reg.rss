// Application-menu registration for the headless EXE. Without this resource
// S60 installs the binary but never shows an icon, so there is no way to start
// the loopback listener. Keep the default foreground launch: on FP1 that is
// the path that reliably starts the process; the EXE has no UI of its own.

#include <appinfo.rh>

UID2 KUidAppRegistrationResourceFile
UID3 0xA0000D15

RESOURCE APP_REGISTRATION_INFO
    {
    app_file = "NotiHelper";
    localisable_resource_file = "\\resource\\apps\\NotiHelper";
    }
